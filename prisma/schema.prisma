datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password_hash String
  role          String   @default("MAHASISWA") // "MAHASISWA" | "ADMIN"
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  student       Student?

  @@index([email])
  @@map("users")
}

model Faculty {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  study_programs StudyProgram[]
  students       Student[]

  @@map("faculties")
}

model StudyProgram {
  id         String   @id @default(cuid())
  faculty_id String
  code       String   @unique
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  faculty    Faculty  @relation(fields: [faculty_id], references: [id], onDelete: Restrict)
  students   Student[]

  @@map("study_programs")
}

model AcademicYear {
  id         String   @id @default(cuid())
  name       String   // e.g. "2026/2027 Ganjil"
  start_date DateTime
  end_date   DateTime
  is_active  Boolean  @default(false)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  students   Student[]
  bills      Bill[]

  @@map("academic_years")
}

model Student {
  id               String   @id @default(cuid())
  user_id          String   @unique
  student_number   String   @unique // NIM
  full_name        String
  phone            String?
  photo_url        String?
  address          String?
  faculty_id       String
  study_program_id String
  academic_year_id String
  semester         Int      @default(1)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  user             User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  faculty          Faculty      @relation(fields: [faculty_id], references: [id], onDelete: Restrict)
  study_program    StudyProgram @relation(fields: [study_program_id], references: [id], onDelete: Restrict)
  academic_year    AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Restrict)

  submissions      AssignmentSubmission[]
  bills            Bill[]
  payments         Payment[]
  notification_reads NotificationRead[]

  @@index([student_number])
  @@index([user_id])
  @@map("students")
}

model Course {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  credits     Int      @default(3) // SKS
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  schedules   CourseSchedule[]
  assignments Assignment[]

  @@map("courses")
}

model CourseSchedule {
  id            String   @id @default(cuid())
  course_id     String
  lecturer_name String
  class_name    String   // e.g. "TI-5A"
  room          String   // e.g. "Lab 301"
  day_of_week   String   // "Senin", "Selasa", "Rabu", "Kamis", "Jumat", "Sabtu"
  start_time    String   // e.g. "08:00"
  end_time      String   // e.g. "10:30"
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  course        Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@map("course_schedules")
}

model Assignment {
  id             String   @id @default(cuid())
  course_id      String
  title          String
  description    String
  instructions   String?
  deadline       DateTime
  attachment_url String?
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  course         Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  submissions    AssignmentSubmission[]

  @@index([deadline])
  @@map("assignments")
}

model AssignmentSubmission {
  id            String   @id @default(cuid())
  assignment_id String
  student_id    String
  file_url      String
  file_name     String?
  submitted_at  DateTime @default(now())
  status        String   @default("DIKUMPULKAN") // BELUM_DIKERJAKAN, DIKERJAKAN, DIKUMPULKAN, TERLAMBAT, DINILAI
  score         Float?
  feedback      String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  assignment    Assignment @relation(fields: [assignment_id], references: [id], onDelete: Cascade)
  student       Student    @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([assignment_id, student_id])
  @@map("assignment_submissions")
}

model Bill {
  id               String   @id @default(cuid())
  student_id       String
  academic_year_id String
  bill_type        String   @default("SPP")
  semester         Int
  amount           Int      // Stored as integer IDR (e.g. 2500000)
  due_date         DateTime
  status           String   @default("UNPAID") // UNPAID, PENDING, PAID, FAILED, EXPIRED
  description      String?
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  student          Student      @relation(fields: [student_id], references: [id], onDelete: Restrict)
  academic_year    AcademicYear @relation(fields: [academic_year_id], references: [id], onDelete: Restrict)
  payments         Payment[]

  @@index([student_id])
  @@index([status])
  @@map("bills")
}

model Payment {
  id                 String   @id @default(cuid())
  bill_id            String
  student_id         String
  order_id           String   @unique
  transaction_id     String?  @unique
  gross_amount       Int      // Stored as integer IDR
  payment_type       String?  // qris, bank_transfer, echannel, gopay, cstore
  transaction_status String   @default("pending") // pending, settlement, capture, deny, cancel, expire, failure, refund
  fraud_status       String?
  snap_token         String?
  snap_redirect_url  String?
  settlement_time    DateTime?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  bill               Bill     @relation(fields: [bill_id], references: [id], onDelete: Restrict)
  student            Student  @relation(fields: [student_id], references: [id], onDelete: Restrict)
  logs               PaymentLog[]
  receipt            Receipt?

  @@index([student_id])
  @@index([bill_id])
  @@index([order_id])
  @@index([transaction_id])
  @@map("payments")
}

model PaymentLog {
  id                 String   @id @default(cuid())
  payment_id         String
  event_type         String
  transaction_status String
  payload            String   // Clean JSON string (no secrets)
  processed_at       DateTime @default(now())
  created_at         DateTime @default(now())

  payment            Payment  @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@map("payment_logs")
}

model Receipt {
  id             String   @id @default(cuid())
  payment_id     String   @unique
  receipt_number String   @unique // e.g. RCP-20261001-XXXX
  issued_at      DateTime @default(now())
  file_url       String?
  created_at     DateTime @default(now())

  payment        Payment  @relation(fields: [payment_id], references: [id], onDelete: Restrict)

  @@map("receipts")
}

model Notification {
  id                String   @id @default(cuid())
  title             String
  message           String
  type              String   // BILL_CREATED, PAYMENT_SUCCESS, ASSIGNMENT_CREATED, SCHEDULE_CHANGED, ANNOUNCEMENT
  target_student_id String?  // Null means all students
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  reads             NotificationRead[]

  @@index([created_at])
  @@map("notifications")
}

model NotificationRead {
  id              String       @id @default(cuid())
  notification_id String
  student_id      String
  read_at         DateTime     @default(now())

  notification    Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  student         Student      @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@unique([notification_id, student_id])
  @@map("notification_reads")
}

model AuditLog {
  id         String   @id @default(cuid())
  user_id    String?
  action     String
  entity     String
  entity_id  String?
  details    String?
  ip_address String?
  created_at DateTime @default(now())

  @@map("audit_logs")
}
