# Server & Database
NODE_ENV=development
PORT=3000
DATABASE_URL="file:./prisma/dev.db"

# Authentication
JWT_SECRET=super_secret_jwt_key_siakad_pro_replace_in_prod
JWT_EXPIRES_IN=7d

# Midtrans Payment Gateway (Sandbox default)
# Get keys from https://dashboard.sandbox.midtrans.com/ -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-YOUR_SANDBOX_SERVER_KEY
MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_SANDBOX_CLIENT_KEY
MIDTRANS_IS_PRODUCTION=false

# Client API configuration (defaults to relative /api when hosted full-stack)
VITE_API_URL=/api
VITE_MIDTRANS_CLIENT_KEY=SB-Mid-client-YOUR_SANDBOX_CLIENT_KEY

# Cloud run / AI studio environment
APP_URL=

